# Copy this file to .env (or set these as env vars in Sevalla) and fill in real values.
# YOURLS_COOKIEKEY: generate with `openssl rand -hex 32` -- never reuse the sample value.

YOURLS_DB_HOST=your-db-host
YOURLS_DB_NAME=yourls
YOURLS_DB_USER=your-db-user
YOURLS_DB_PASS=your-db-password
YOURLS_DB_PREFIX=yourls_

YOURLS_SITE=https://your-domain.example
YOURLS_COOKIEKEY=change-me-generate-a-long-random-string

YOURLS_USER=admin
YOURLS_PASSWORD=change-me

YOURLS_PRIVATE=true

# Optional: needed for the "forgot password" feature to actually deliver emails.
# Without these, it falls back to PHP's mail(), which usually does NOT work in a
# container without a configured local mail server -- set these for real delivery.
# Example values for Gmail SMTP: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@your-domain.example
